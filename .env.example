# Copy to .env — all optional for local dev.

# Secret used to sign sessions. REQUIRED in production.
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical URL of the deployment (silences the better-auth base-URL warning).
BETTER_AUTH_URL=http://localhost:3000

# SQLite database file location.
DATABASE_URL=./data/mebar.db

# First manager account created by `npm run db:seed`.
MANAGER_EMAIL=admin@lab.local
MANAGER_PASSWORD=mebar-admin

# Optional: SMTP for "forgot password" reset emails. All five must be set
# for the email flow to activate; otherwise resets go through a coordinator.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mebar Manager <no-reply@example.com>"
