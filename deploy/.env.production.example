# Copy to deploy/.env and fill in before `docker compose up -d`.

# Your domain — Caddy fetches the HTTPS certificate for it automatically.
DOMAIN=mebar.example.org

# REQUIRED. Generate once:  openssl rand -base64 32
# The app refuses to start in production without it.
BETTER_AUTH_SECRET=

# Optional: SMTP for "forgot password" emails. Leave empty to use
# coordinator-driven resets from the People page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mebar Manager <mebar@example.org>"

# --- Off-site backups (optional) ------------------------------------------
# These are read by deploy/backup.sh from its CRON environment (NOT by docker
# compose). Set them on the crontab line or a wrapper, e.g.:
#   15 3 * * * BACKUP_REMOTE=s3:my-bucket/mebar /opt/mebar-manager/deploy/backup.sh \
#     >> /var/log/mebar-backup.log 2>&1
#
# BACKUP_REMOTE=s3:my-bucket/mebar        # rclone remote, or user@host:/srv/mebar
# BACKUP_REMOTE_METHOD=                   # rclone | scp | rsync (auto if empty)
# BACKUP_REMOTE_KEEP_DAYS=30              # rclone-only remote retention (optional)
