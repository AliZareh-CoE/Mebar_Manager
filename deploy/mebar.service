# systemd unit: keeps the compose stack up across reboots.
#   sudo cp deploy/mebar.service /etc/systemd/system/
#   sudo systemctl enable --now mebar
# Adjust WorkingDirectory to wherever you cloned the repo.
[Unit]
Description=Mebar Manager (docker compose stack)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mebar-manager/deploy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --build

[Install]
WantedBy=multi-user.target
